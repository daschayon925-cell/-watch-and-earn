{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firestore-blueprint.json",
  "entities": {
    "users": {
      "description": "User profiles, wallet balances, credentials and activity logs",
      "fields": {
        "id": { "type": "string", "description": "Unique user identifier (UID or phone-based)" },
        "name": { "type": "string", "description": "User full name" },
        "phone": { "type": "string", "description": "User Bangladeshi phone number" },
        "password": { "type": "string", "description": "Hashed or secured user password" },
        "coins": { "type": "number", "description": "Current active coin balance" },
        "totalEarned": { "type": "number", "description": "Lifetime earned coins" },
        "totalWithdrawn": { "type": "number", "description": "Lifetime withdrawn amount in BDT" },
        "referralCode": { "type": "string", "description": "User referral code" },
        "referredBy": { "type": "string", "description": "Referrer code if referred" },
        "totalReferrals": { "type": "number", "description": "Count of referred users" },
        "isBanned": { "type": "boolean", "description": "Whether user is suspended by admin" },
        "joinedAt": { "type": "string", "description": "Registration ISO timestamp" },
        "lastActiveAt": { "type": "string", "description": "Last active ISO timestamp" },
        "lastBonusClaimAt": { "type": "string", "description": "Last daily bonus claim ISO timestamp" },
        "todayAdClicks": { "type": "number", "description": "Daily ad click count" },
        "lastAdClickDate": { "type": "string", "description": "YYYY-MM-DD for ad click limit resets" },
        "watchedVideos": { "type": "array", "description": "Array of watched video IDs" }
      }
    },
    "settings": {
      "description": "Global system configurations and Adsterra ad codes",
      "fields": {
        "siteName": { "type": "string", "description": "Application display name" },
        "siteNotice": { "type": "string", "description": "Top marquee/banner notice" },
        "coinRate": { "type": "number", "description": "100 coins rate in BDT" },
        "minWithdrawCoins": { "type": "number", "description": "Minimum withdrawal threshold" },
        "referralRewardCoins": { "type": "number", "description": "Referral bonus coins" },
        "videoRewardCoins": { "type": "number", "description": "Coins rewarded per video watch" },
        "watchDurationSeconds": { "type": "number", "description": "Required watch duration in seconds" },
        "telegramSupportUrl": { "type": "string", "description": "Telegram help channel link" },
        "whatsappSupportUrl": { "type": "string", "description": "WhatsApp contact link" },
        "isWithdrawalActive": { "type": "boolean", "description": "Withdrawal system toggle" },
        "adsConfig": { "type": "object", "description": "Adsterra configuration and direct links" }
      }
    },
    "videos": {
      "description": "Admin managed YouTube videos for watch-to-earn",
      "fields": {
        "id": { "type": "string", "description": "Unique video ID" },
        "title": { "type": "string", "description": "Bangla video title" },
        "youtubeId": { "type": "string", "description": "YouTube 11-char video ID" },
        "coinsReward": { "type": "number", "description": "Coins reward for full watch" },
        "durationSeconds": { "type": "number", "description": "Duration required to watch" },
        "category": { "type": "string", "description": "Video category tag" },
        "thumbnail": { "type": "string", "description": "Thumbnail preview URL" },
        "isActive": { "type": "boolean", "description": "Whether video is visible" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      }
    },
    "withdrawals": {
      "description": "Cashout requests from users for bKash, Nagad, and Rocket",
      "fields": {
        "id": { "type": "string", "description": "Unique withdrawal request ID" },
        "userId": { "type": "string", "description": "User identifier" },
        "userName": { "type": "string", "description": "User name" },
        "userPhone": { "type": "string", "description": "User account phone" },
        "method": { "type": "string", "description": "bkash, nagad, or rocket" },
        "accountType": { "type": "string", "description": "Personal or Agent" },
        "accountNumber": { "type": "string", "description": "Payment receiving number" },
        "coins": { "type": "number", "description": "Requested coins amount" },
        "amountBDT": { "type": "number", "description": "Converted BDT amount" },
        "status": { "type": "string", "description": "pending, approved, or rejected" },
        "requestedAt": { "type": "string", "description": "Request creation ISO timestamp" },
        "processedAt": { "type": "string", "description": "Admin resolution ISO timestamp" },
        "adminNote": { "type": "string", "description": "Optional admin memo or TrxID" }
      }
    }
  }
}
