rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'daschayon925@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User collection rules
    // Users can read public parts or own profile, but CANNOT modify coins/balance directly from client
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // Creation: restricted fields
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'email', 'coins', 'accountStatus', 'role'])
        && request.resource.data.coins == 0
        && request.resource.data.role == 'user'
        && request.resource.data.accountStatus == 'active';
      
      // Update: User can only update their displayName and photoURL, never balance or status
      allow update: if (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
      ) || isAdmin();

      allow delete: if isOwner(userId) || isAdmin();
    }

    // Public Videos
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reward Transactions (Server authoritative / Admin only writes)
    match /rewardTransactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (request.query.limit <= 50 && resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin(); // Users cannot forge transactions
    }

    // Withdrawals
    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can create a withdrawal request with status 'Pending' only
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.coins >= 1000
        && request.resource.data.mobileNumber.matches('^01[3-9][0-9]{8}$');
        
      // Only admin can approve, pay, or reject
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reports (Users can submit copyright / content reports)
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Admin Settings (Public read for app configs, admin only write)
    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
